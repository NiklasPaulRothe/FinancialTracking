# =============================================================================
# Haushaltsbuch Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   copy .env.example .env
# =============================================================================

# Database connection (required)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/haushaltsbuch

# Flask secret key for session signing (change in production!)
SECRET_KEY=change-me-to-a-random-string

# Flask environment: development | testing | production
FLASK_ENV=development

# Optional: separate test database
# TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/haushaltsbuch_test
